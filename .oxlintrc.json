{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc"],
  "categories": { "correctness": "error" },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["out/**", "node_modules/**", ".vscode-test/**"]
}
