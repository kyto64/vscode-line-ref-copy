{
  "name": "line-ref-copy",
  "displayName": "Line Ref Copy",
  "description": "Copy selected lines with line numbers and optional file path—ready to paste into issues, reviews, and chat.",
  "version": "0.1.2",
  "preview": true,
  "publisher": "kyto64",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copy",
    "clipboard",
    "line number",
    "reference",
    "paste"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kyto64/vscode-line-ref-copy.git"
  },
  "bugs": {
    "url": "https://github.com/kyto64/vscode-line-ref-copy/issues"
  },
  "homepage": "https://github.com/kyto64/vscode-line-ref-copy#readme",
  "main": "./out/src/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Line Ref Copy",
      "properties": {
        "lineRefCopy.showSuccessMessage": {
          "type": "boolean",
          "default": true,
          "description": "Show an information message after a successful copy."
        }
      }
    },
    "commands": [
      {
        "command": "lineRefCopy.withoutPath",
        "title": "Line Ref Copy: Without Path"
      },
      {
        "command": "lineRefCopy.withFullPath",
        "title": "Line Ref Copy: With Full Path"
      },
      {
        "command": "lineRefCopy.withRelativePath",
        "title": "Line Ref Copy: With Relative Path"
      },
      {
        "command": "lineRefCopy.withFileName",
        "title": "Line Ref Copy: With File Name"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lineRefCopy.withRelativePath",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_cutcopypaste@5"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.74.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.0",
    "glob": "^13.0.0",
    "js-yaml": "5.5.0",
    "mocha": "^12.0.3",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "rules:generate": "npx --yes rulesync@33.0.0 generate && node .rulesync/apply-devin-frontmatter.mjs",
    "test": "npm run compile && node ./out/test/runTest.js",
    "vscode:prepublish": "npm run compile",
    "vsce:ls": "vsce ls",
    "vsce:package": "vsce package",
    "watch": "tsc -watch -p ./"
  }
}
